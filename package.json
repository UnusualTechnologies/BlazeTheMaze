{
  "name": "blaze-the-maze",
  "version": "1.0.0",
  "description": "Fast-paced multiplayer maze racing game. First to the centre wins.",
  "author": "Unusual Technologies",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win"
  },
  "dependencies": {
    "steamworks.js": "^0.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.yourstudio.blazethemaze",
    "productName": "Blaze The Maze",
    "asar": true,
    "win": {
      "target": "portable",
      "sign": null,
      "icon": "build/favicon.ico"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "vendor/**/*",
      "steam_appid.txt"
    ],
    "extraResources": [
      { "from": "steam_appid.txt", "to": "steam_appid.txt" }
    ]
  }
}
